{
  "name": "bautisacrum",
  "private": true,
  "version": "1.0.1",
  "description": "Aplicación de escritorio para certificados de bautismo",
  "main": "electron/main.js",
  "icon": "build/icon.ico",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "npm run dev --prefix iglesia-bautismo-frontend",
    "dev:electron": "set ELECTRON_START_URL=http://localhost:5173 && wait-on http://localhost:5173 && electron .",
    "electron:start": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "build:frontend": "cd iglesia-bautismo-frontend && npm run build",
    "backend": "node bautismo-backend/server.js",
    "build:react": "npm run build --prefix iglesia-bautismo-frontend",
    "start": "electron .",
    "dist": "npm run build:react && electron-builder"
  },
  "build": {
    "appId": "com.bautisacrum.app",
    "productName": "BautiSacrum",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "iglesia-bautismo-frontend/dist/**/*",
      "electron/**/*",
      "build/**/*",
      "bautismo-backend/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "BautiSacrum",
    "uninstallDisplayName": "BautiSacrum",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },
  "keywords": [],
  "author": "Ronald Hernández",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.0",
    "cors": "^2.8.5",
    "electron-context-menu": "^4.1.1",
    "electron-is-dev": "^3.0.1",
    "express": "^5.1.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.3.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  }
}
